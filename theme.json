{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#eeedeb"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#262623"
        },
        {
          "slug": "studio-orange",
          "name": "Studio Orange",
          "color": "#ff5e11"
        },
         {
          "slug": "studio-blue",
          "name": "Studio Blue",
          "color": "#227499"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#ffffff"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Sans Serif",
          "fontFamily": "Manrope, Helvetica, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Monospace",
          "fontFamily": "\"Courier New\", Courier, monospace"
        },
        {
          "fontFamily": "Manrope, sans-serif",
          "slug": "manrope",
          "name": "Manrope",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontWeight": "200 800",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/ManropeVar.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.75rem"
        },
        {
          "slug": "body",
          "name": "Body",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.5rem, 3vw, 2.5rem)"
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(3.5rem, 8.5vw, 9.375rem)"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.75rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1.5rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "2rem"
        },
        {
          "slug": "section",
          "name": "Section",
          "size": "clamp(3rem, 6vw, 6rem)"
        },
        {
          "slug": "gutter",
          "name": "Page Gutter",
          "size": "clamp(1.25rem, 4vw, 4rem)"
        }
      ]
    },
    "custom": {
      "color": {
        "line": "rgba(38, 38, 35, 0.22)",
        "lineOnAccent": "rgba(255, 255, 255, 0.45)"
      },
      "typography": {
        "labelSize": "0.875rem",
        "labelTracking": "0.025em",
        "displayTracking": "-0.075em",
        "displayLineHeight": "0.9"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|heading",
      "fontSize": "var:preset|font-size|body",
      "fontWeight": "400",
      "lineHeight": "1.5"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "700",
          "lineHeight": "1.05",
          "letterSpacing": "-0.05em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(3rem, 6vw, 6rem)",
          "lineHeight": "1",
          "letterSpacing": "-0.06em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.25rem, 1.5vw, 4rem)",
          "lineHeight": "1.05",
          "letterSpacing": "-0.05em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.75rem, 3vw, 2.5rem)",
          "lineHeight": "1.1",
          "letterSpacing": "-0.04em"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "clamp(1.375rem, 2vw, 1.75rem)",
          "lineHeight": "1.15",
          "letterSpacing": "-0.03em"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "1.125rem",
          "lineHeight": "1.2",
          "letterSpacing": "-0.02em"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "1rem",
          "lineHeight": "1.25",
          "letterSpacing": "-0.01em"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|ink"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|studio-green",
          "text": "var:preset|color|white"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|small"
        }
      }
    }
  }
}
